{
  "manifest_version": 3,
  "name": "UI-Anatomist",
  "description": "Analyze rendered web UIs and rebuild observable design-system assets as editable Figma assets.",
  "version": "0.1.0",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
